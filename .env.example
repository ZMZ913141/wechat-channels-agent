# ============================================================
# 数据目录（数据库、浏览器档案、日志、截图、缩略图）
# 换电脑只需改这里 + 重新扫码登录
# ============================================================
WX_DATA_DIR=D:\wechat_channels_data

# 素材收件箱固定是「数据目录\inbox」，随 WX_DATA_DIR 一起移动，无需单独配置

# ============================================================
# 服务
# ============================================================
WX_HOST=127.0.0.1
WX_PORT=8734

# ============================================================
# 调度器（后台自动执行到点的发布任务）
# ============================================================
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_S=30
# 审计日志保留天数（0 = 永久保留）
AUDIT_RETENTION_DAYS=90

# ============================================================
# 登录态保活（定期访问各账号创作者后台，兼顾掉线巡检）
# 频率别低于 2 小时，太密容易触发平台风控
# ============================================================
LOGIN_KEEPALIVE_ENABLED=true
# 每轮间隔（秒），默认 3 小时
LOGIN_KEEPALIVE_INTERVAL_S=10800
# 服务启动后延迟多久跑首轮（秒），避免重启即批量开窗
LOGIN_KEEPALIVE_START_DELAY_S=600
# 账号之间的随机错峰上限（秒），模拟自然访问节奏
LOGIN_KEEPALIVE_STAGGER_S=20

# ============================================================
# LLM（AI 写文案/打标签用）
# 不配 key 时「✨ AI 完善」会回退本地规则（非真 AI，界面会红字提示"AI 未启用"）
# 配置方式任选其一：
#   1) 本地网关（已验证）：填你本地 OpenAI 兼容地址，例如
#      LLM_BASE_URL=http://127.0.0.1:8787/v1
#      LLM_API_KEY=<你的网关 key>
#      LLM_MODEL=aggregate/free
#   2) DeepSeek（便宜、无需翻墙）：
#      LLM_BASE_URL=https://api.deepseek.com/v1
#      LLM_API_KEY=sk-xxx
#      LLM_MODEL=deepseek-chat
# 配置后在界面点「测试 AI」可一键验证是否可用。
# ============================================================
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# ============================================================
# 浏览器与发布
# ============================================================
# 留空=Playwright 自带 Chromium（推荐，零配置，uv run playwright install chromium 后即可用）
# 填 chrome / msedge 则复用本机浏览器（指纹与日常一致）
BROWSER_CHANNEL=
# 发布是否无头（扫码登录始终有头）
PUBLISH_HEADLESS=true
# 视频上传硬超时（秒）
PUBLISH_UPLOAD_TIMEOUT_S=3600
# 同账号发布间隔（分钟）
PUBLISH_SAME_ACC_INTERVAL_MIN=30
# 同内容多账号错峰间隔（分钟）
PUBLISH_STAGGER_MIN=30
# 每号每日发布上限
PUBLISH_DAILY_LIMIT=3
# 每次操作间拟人延时（秒）
WAIT_BETWEEN_ACTIONS=1.0

# ============================================================
# 视频号发表页
# ============================================================
PUBLISH_URL=https://channels.weixin.qq.com/platform/post/create
