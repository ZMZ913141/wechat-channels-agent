# ============================================================
# LLM 配置（AI 智能填写标题/短标题/文案/话题/AI标注；发布回退方案也用它）
# 推荐 DeepSeek（便宜好用，无需翻墙），也支持 openai / google / anthropic
# ============================================================
LLM_PROVIDER=deepseek
LLM_API_KEY=你的key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# ============================================================
# 浏览器
# ============================================================
# 默认账号的登录态目录（多账号请到面板「账号管理」各自配置独立目录）
USER_DATA_DIR=./browser_profile
# 视觉模式：DeepSeek-chat 等纯文本模型必须 false；换 gpt-4o/deepseek-vl 等视觉模型才设 true
USE_VISION=false
# 浏览器渠道：留空=用 Playwright 自带 Chromium；设为 chrome / edge 可复用本机已装浏览器，指纹更一致
BROWSER_CHANNEL=
# 每次操作之间的拟人延时（秒），0=不设置。轻微降低被风控概率
WAIT_BETWEEN_ACTIONS=1.0
# 禁用 browser-use 自带扩展下载（联网下载在代理/受限网络下会卡死，导致浏览器启动超时）。保持 true
BROWSER_DISABLE_EXTENSIONS=true
# 视频号发表页地址（手动上传时一键打开；若默认地址失效，改成你实际进入发表页的 URL）
PUBLISH_URL=https://channels.weixin.qq.com/platform/post/create

# ============================================================
# 同步发布（一条视频发到多个视频号）
# ============================================================
# 发布是否无头运行（不弹窗口）。默认 true —— 自动流程不打断你。
# 需��肉眼确认上传过程时设 false（注意：扫码登录一直是有头的，不受此影响）
PUBLISH_HEADLESS=true

# 发布方式：
#   deterministic = 确定性填写（Playwright 直填表单，不用 LLM，快且稳，推荐）
#   agent         = browser-use Agent「看懂页面」操作（依赖 LLM，适合大幅改版时）
PUBLISH_METHOD=deterministic
# 确定性方式失败时，是否自动回退到 Agent 方案（false=只走确定性，便于排查）
PUBLISH_AUTO_FALLBACK=true
# 视频上传的硬超时（秒）。实测 172MB / 上行 0.5Mbps 会传到一半失败，
# 不设上限就会无限重传、任务永远挂住。默认 3600（1 小时）
PUBLISH_UPLOAD_TIMEOUT_S=3600
# 同账号并发发布时的账号锁等待秒数。0=不等，直接提示你稍后重试；
# 想让「连点两次发布」时第二个任务等第一个跑完，可设1800
PUBLISH_TASK_LOCK_WAIT_S=0

# ============================================================
# 状态存储
# ============================================================
STATE_DIR=./state