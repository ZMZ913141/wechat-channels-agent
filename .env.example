# ============================================================
# LLM 配置（私信监控需要：让大模型“看懂”视频号私信页并提取）
# 推荐 DeepSeek（便宜好用，无需翻墙），也支持 openai / google / anthropic
# ============================================================
LLM_PROVIDER=deepseek
LLM_API_KEY=你的key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# ============================================================
# 浏览器
# ============================================================
# 监控默认无头运行（true，后台不弹窗）；首次扫码登录或调试时设 false
MONITOR_HEADLESS=true
# 登录态持久化目录（默认账号用；多账号请到面板「账号管理」配置各自独立目录）
USER_DATA_DIR=./browser_profile
# 视觉模式：DeepSeek-chat 等纯文本模型必须 false；换 gpt-4o/deepseek-vl 等视觉模型才设 true
USE_VISION=false
# 抗检测 / 拟人（可选，提升“抗改版/抗风控”能力）：
# 浏览器渠道：留空=用 Playwright 自带 Chromium；设为 chrome / edge 可复用本机已装浏览器，指纹更一致
BROWSER_CHANNEL=
# 每次操作之间的拟人延时（秒），0=不设置。轻微降低被风控概率
WAIT_BETWEEN_ACTIONS=1.0
# 禁用 browser-use 自带扩展下载（联网下载在代理/受限网络下会卡死，导致浏览器启动超时）。保持 true
BROWSER_DISABLE_EXTENSIONS=true
# 确定性提取是否无头（仅抓私信时有效；抓评论时视频号助手会把深链重定向回首页，强制有头）
PW_HEADLESS=false
# 单条自动回复超时上限（秒）。AI Agent 在视频号无界微前端里可能空转，超时后下一轮重试
REPLY_TIMEOUT_S=150
# 视频号发表页地址（手动上传时一键打开；若默认地址失效，改成你实际进入发表页的 URL）
PUBLISH_URL=https://channels.weixin.qq.com/platform/post/create

# ============================================================
# 私信/评论通知（本项目核心）
# 渠道：wecom_app = 企业微信应用消息（官方API，直推企业微信App，
#       企业微信里开启“微信插件”后可同时转发到个人微信）
#       serverchan / pushplus = 直接推到你的【个人微信】（借服务号通道）
#       webhook = 推到企业微信/钉钉【群】
# ============================================================
NOTIFY_CHANNEL=serverchan
# —— 企业微信应用消息（NOTIFY_CHANNEL=wecom_app 时生效）：
#    企业微信管理后台 → 应用管理 → 创建自建应用，拿 AgentId + Secret；
#    corpid 在「我的企业」页；接收人在「微信插件」关注后可微信收消息
WECOM_CORPID=
WECOM_SECRET=
WECOM_AGENTID=
WECOM_TOUSER=@all
# —— Server酱（推个人微信）：https://sct.ftqq.com 注册拿到 SendKey
SERVERCHAN_SENDKEY=
# —— PushPlus（推个人微信）：https://www.pushplus.plus 注册拿到 token
PUSHPLUS_TOKEN=
# —— 企业微信/钉钉群机器人（可选，NOTIFY_CHANNEL=webhook 时生效）
NOTIFY_WEBHOOK=
NOTIFY_WEBHOOK_TYPE=wecom

# 监控轮询间隔（秒），默认 5 分钟
MONITOR_INTERVAL=300
# 是否同时监控「评论管理」里的视频评论（与私信同一轮完成，不额外翻倍 token）
MONITOR_COMMENTS=true
# 固定规则自动回复总开关（规则在面板「自动回复」页维护）
AUTO_REPLY_ENABLED=false
# 评论是否也自动回复（与私信共用规则库；评论可用 scope=comment 单独配）
AUTO_REPLY_COMMENTS=true
# 同一个人只自动回复一次（true = 首次之后不再自动回）
AUTO_REPLY_ONCE_PER_USER=true
# 同一人两次自动回复的冷却秒数（0=不限，仅在上面为 false 时生效）
AUTO_REPLY_COOLDOWN=0

# ============================================================
# 同步发布（一条视频发到多个视频号）
# ============================================================
# 发布过程默认有头浏览器（false），方便肉眼确认；稳定后可设 true 后台跑
PUBLISH_HEADLESS=false

# 发布方式：
#   deterministic = 确定性填写（Playwright 直填表单，不用 LLM，快且稳，推荐）
#   agent         = browser-use Agent「看懂页面」操作（依赖 LLM，适合大幅改版时）
PUBLISH_METHOD=deterministic
# 确定性方式失败时，是否自动回退到 Agent 方案（false=只走确定性，便于排查）
PUBLISH_AUTO_FALLBACK=true
# 视频上传的硬超时（秒）。实测 172MB / 上行 0.5Mbps 会传到一半失败，
# 不设上限就会无限重传、任务永远挂住。默认 3600（1 小时）
PUBLISH_UPLOAD_TIMEOUT_S=3600

# ============================================================
# 关机看门狗（监控停止即关机，睡前用）
# ============================================================
# 心跳超过该秒数未更新 → 视为进程卡死/崩溃（默认 10 分钟）
SHUTDOWN_HEARTBEAT_TIMEOUT=600
# 超过该秒数没有一次“成功检查” → 视为持续断网/接口异常（默认 30 分钟）
SHUTDOWN_SUCCESS_TIMEOUT=1800

# ============================================================
# 状态存储
# ============================================================
STATE_DIR=./state
